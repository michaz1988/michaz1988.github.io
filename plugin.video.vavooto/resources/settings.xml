<settings> 
  <category label="TV">
    <setting default="0" id="live_priority" label="Quellen-Vorrang (Priorität)" type="enum" values="VAVOO > Stalker > LiteTV|LiteTV > VAVOO > Stalker|Stalker > VAVOO > LiteTV|LiteTV > Stalker > VAVOO|VAVOO > LiteTV > Stalker|Stalker > LiteTV > VAVOO" />
    <setting default="0" id="auto" label="IPTV Autoplay" type="enum" values="Auto|Countdown|Manuell" />
    <setting default="5" id="count" label="Countdown Zeit" type="number" option="int" visible="eq(-1,1)" />
    <setting default="false" id="stream_count" type="bool" label="Anzahl Streams in Title anzeigen"/>
    <setting default="true" id="live_m3u8_test" type="bool" label="M3U8 vor der Wiedergabe testen"/>
    <setting default="true" id="live_auto_retry" type="bool" label="Live-TV bei Streamabbruch automatisch neu verbinden"/>
    <setting default="3" id="live_retry_count" type="number" option="int" label="Neuverbindungsversuche (mind. Anzahl Quellen)" visible="eq(-1,true)"/>
    <setting default="true" id="filter" type="bool" label="Kanalfilter verwenden"/>
    <setting label="Alle Favoriten entfernen" type="action" action="RunPlugin(plugin://plugin.video.vavooto/?action=delallTvFavorit)"/>
  </category>
  <category label="LITETV">
    <setting default="true" id="lite" type="bool" label="LiteTV (2ix2 / Nydus) verwenden"/>
    <setting label="LiteTV Cache leeren" type="action" visible="eq(-1,true)" action="RunPlugin(plugin://plugin.video.vavooto/?action=clear_lite_cache)"/>
  </category>
  <category label="VAVOO">
    <setting default="true" id="vavoo" type="bool" label="VAVOO TV verwenden"/>
    <setting default="true" id="vavoo_hls_proxy" type="bool" label="VAVOO HLS Proxy verwenden (Stabilere Wiedergabe)" visible="eq(-1,true)"/>
    <setting default="true" id="vavoo_proxy_prefetch" type="bool" label="VAVOO Proxy: Segmente vorausladen (Puffer gegen Aussetzer)" visible="eq(-1,true)"/>
    <setting label="VAVOO Kanalgruppen Auswahl" type="action" visible="eq(-3,true)" action="RunPlugin(plugin://plugin.video.vavooto/?action=choose)"/>
  </category>
  <category label="STALKER">
    <setting default="true" id="stalker" type="bool" label="Stalkerportal verwenden"/>
    <setting default="true" id="stalker_ts_hls_proxy" type="bool" label="Stalker TS als HLS mit Reconnect wiedergeben" visible="eq(-1,true)"/>
    <setting label="STALKER Portal Auswahl" type="action" visible="eq(-2,true)" action="RunPlugin(plugin://plugin.video.vavooto/?action=choose_portal)"/>
    <setting label="Neue Mac Adresse" type="action" visible="eq(-3,true)" action="RunPlugin(plugin://plugin.video.vavooto/?action=new_mac)"/>
    <setting label="STALKER Kanalgruppen Auswahl" type="action" visible="eq(-4,true)" action="RunPlugin(plugin://plugin.video.vavooto/?action=get_genres)"/>
    <setting label="STALKER Portal Check Retries" type="number" id="stalker_retry" default="10" visible="eq(-5,true)"/>
    <setting default="5" id="stalk_cache" label="STALKER TV Cache in Std" type="number" option="int" visible="eq(-6,true)" />
    <setting label="STALKER Portal" type="text" id="stalkerurl" default="http://a01.live:8080/c/" visible="eq(-7,true)"/>
    <setting label="STALKER Mac" type="text" id="mac" default="00:2a:01:93:ed:80" visible="eq(-8,true)"/>
    <setting label="STALKER Portal Check" type="text" id="portal_ok" default="" visible="eq(-9,true)" enable="false"/>
    <setting label="Account Info" type="text" id="account_info" default="" visible="eq(-10,true)" enable="false"/>
  </category>
  <category label="VIDEO">
    <setting default="1" id="stream_select" label="Stream Auswahl" type="enum" values="Hoster|Automatisch" />
    <setting default="true" id="auto_try_next_stream" type="bool" visible="eq(-1,0)" label="Automatisch nächsten ähnlichen Stream versuchen"/>
    <setting default="0" id="stream_quali" label="Max Stream Qualität" type="enum" values="1080p|720p|480p" />
    <setting default="true" id="stream_check" type="bool" label="Streams Testen"/>
    <setting label="Suchverlauf löschen" type="action" action="RunPlugin(plugin://plugin.video.vavooto/?action=delete_search&amp;id=all)"/>
  </category>
  <category label="DEBUG">
    <setting default="false" id="debug" type="bool" label="Debug Logging"/>
    <setting default="true" id="comp" type="bool" label="Cache komprimieren"/>
    <setting label="Cache löschen" type="action" action="RunPlugin(plugin://plugin.video.vavooto/?action=clear)"/>
  </category>
</settings>
